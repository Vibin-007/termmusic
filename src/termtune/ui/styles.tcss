/* TermTune Dark Black & White Minimalist Theme */

Screen {
    background: #000000;
    color: #ffffff;
    layout: vertical;
    scrollbar-color: #ffffff;
    scrollbar-color-hover: #ffffff;
    scrollbar-background: #09090b;
    scrollbar-background-hover: #18181b;
}

/* Scrollbar styling - pure monochrome white */
Scrollbar {
    background: #09090b;
    color: #ffffff;
}

Scrollbar:hover {
    background: #18181b;
    color: #ffffff;
}

ScrollBarCorner {
    background: #09090b;
}

/* Header Banner */
#header-box {
    dock: top;
    height: 3;
    background: #09090b;
    border-bottom: heavy #ffffff;
    content-align: center middle;
    padding: 0 1;
}

#header-title {
    text-style: bold;
    color: #ffffff;
}

#header-subtitle {
    color: #71717a;
}

/* Main Workspace Grid */
#main-container {
    width: 100%;
    height: 1fr;
    layout: horizontal;
    padding: 0;
}

/* Responsive Panes */
.wide-layout #left-pane {
    width: 58%;
    height: 100%;
}

.wide-layout #right-pane {
    width: 42%;
    height: 100%;
}

.narrow-layout #main-container {
    layout: vertical;
}

.narrow-layout #left-pane {
    width: 100%;
    height: 55%;
}

.narrow-layout #right-pane {
    width: 100%;
    height: 45%;
}

#left-pane {
    padding: 0 1;
    layout: vertical;
}

#right-pane {
    padding: 0 1;
    layout: vertical;
}

/* Search Widget */
SearchWidget {
    height: auto;
    margin-bottom: 1;
}

#search-input {
    background: #09090b;
    color: #ffffff;
    border: round #27272a;
    padding: 0 1;
}

#search-input:focus {
    border: round #ffffff;
    background: #18181b;
}

#search-status {
    color: #a1a1aa;
    height: 1;
    content-align: left middle;
    margin-top: 0;
}

#recent-searches {
    height: 1;
    color: #71717a;
    margin-top: 0;
}

/* Search Results Widget */
SearchResultsWidget {
    height: 1fr;
    border: round #27272a;
    background: #09090b;
    padding: 0 1;
}

SearchResultsWidget:focus-within {
    border: round #ffffff;
}

#results-header {
    text-style: bold;
    color: #ffffff;
    background: #18181b;
    padding: 0 1;
    height: 1;
    content-align: left middle;
    margin-bottom: 1;
}

#results-list {
    height: 1fr;
    background: transparent;
    border: none;
    scrollbar-color: #ffffff;
    scrollbar-background: #09090b;
}

#results-list > ListItem {
    padding: 0 1;
    height: 2;
    background: transparent;
}

#results-list > ListItem.--highlight {
    background: #27272a;
    color: #ffffff;
}

/* Now Playing Widget */
NowPlayingWidget {
    height: auto;
    min-height: 10;
    border: round #ffffff;
    background: #09090b;
    padding: 0 1;
    margin-bottom: 1;
}

#now-playing-header {
    text-style: bold;
    color: #000000;
    background: #ffffff;
    padding: 0 1;
    height: 1;
    content-align: left middle;
    margin-bottom: 1;
}

#now-playing-title {
    text-style: bold;
    color: #ffffff;
    height: 1;
}

#now-playing-artist {
    color: #a1a1aa;
    height: 1;
}

#now-playing-progress {
    color: #ffffff;
    text-style: bold;
    height: 1;
    margin-top: 1;
}

#now-playing-info-bar {
    height: 1;
    color: #a1a1aa;
}

#now-playing-controls-bar {
    content-align: center middle;
    color: #ffffff;
    height: 1;
    margin-top: 0;
}

/* Queue Widget */
QueueWidget {
    height: 1fr;
    border: round #27272a;
    background: #09090b;
    padding: 0 1;
}

QueueWidget:focus-within {
    border: round #ffffff;
}

#queue-header {
    text-style: bold;
    color: #ffffff;
    background: #18181b;
    padding: 0 1;
    height: 1;
    content-align: left middle;
    margin-bottom: 1;
}

#queue-list {
    height: 1fr;
    background: transparent;
    border: none;
    scrollbar-color: #ffffff;
    scrollbar-background: #09090b;
}

#queue-list > ListItem {
    padding: 0 1;
    height: 2;
    background: transparent;
}

#queue-list > ListItem.--highlight {
    background: #27272a;
    color: #ffffff;
}

/* Controls / Keybindings Footer */
ControlsWidget {
    dock: bottom;
    height: 2;
    background: #09090b;
    border-top: solid #27272a;
    padding: 0 1;
    content-align: center middle;
}

#controls-text {
    color: #a1a1aa;
    content-align: center middle;
}

/* Modal Pop-up Dialog */
TrackActionModal, CreatePlaylistModal, PlaylistSelectModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.85);
}

#modal-dialog {
    width: 76;
    height: auto;
    background: #09090b;
    border: heavy #ffffff;
    padding: 1 2;
}

#modal-title {
    text-style: bold;
    color: #000000;
    background: #ffffff;
    content-align: center middle;
    height: 1;
    margin-bottom: 1;
}

#modal-message {
    color: #a1a1aa;
    margin-bottom: 1;
    content-align: center middle;
}

#modal-track-info {
    content-align: center middle;
    margin-bottom: 1;
}

#modal-buttons {
    height: 3;
    content-align: center middle;
    margin-top: 1;
}

#modal-buttons Button {
    margin: 0 1;
    height: 3;
    min-width: 14;
}

#btn-play-now {
    background: #ffffff;
    color: #000000;
    text-style: bold;
}

#btn-play-now:focus {
    background: #e4e4e7;
    color: #000000;
    text-style: bold;
}

#btn-add-queue, #btn-play-next, #btn-add-playlist, #btn-new {
    background: #27272a;
    color: #ffffff;
}

#btn-add-queue:focus, #btn-play-next:focus, #btn-add-playlist:focus, #btn-new:focus {
    background: #3f3f46;
    color: #ffffff;
}

#btn-cancel {
    background: #18181b;
    color: #a1a1aa;
}

#btn-cancel:focus {
    background: #27272a;
    color: #ffffff;
}

#playlist-list {
    height: 10;
    border: round #27272a;
    background: #09090b;
    margin-bottom: 1;
    scrollbar-color: #ffffff;
    scrollbar-background: #09090b;
}
